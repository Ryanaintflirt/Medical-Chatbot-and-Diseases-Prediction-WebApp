# ==============================================
# Environment Variables Template
# ==============================================
# Copy this file to SECRET.env and fill in your actual values
# DO NOT commit SECRET.env to version control!

# ==============================================
# Firebase Configuration (Required)
# ==============================================
# Get these from your Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your apps > SDK setup and configuration

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com

# ==============================================
# AI Chatbot Configuration (Required)
# ==============================================
# DeepSeek API Key - Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter AI API Key - Get from: https://openrouter.ai/
AiApi_Key=your_openrouter_api_key_here

# AI API URL (default is OpenRouter)
AI_Url=https://openrouter.ai/api/v1/chat/completions

# ==============================================
# Optional: Vector Database (Pinecone)
# ==============================================
# Only needed if using RAG with PDF documents
# Get from: https://www.pinecone.io/
PINECONE_API_KEY=

# ==============================================
# Optional: Azure Symptom Checker API
# ==============================================
# Only needed for symptom diagnosis feature
# Get from: https://azure.microsoft.com/
url=
DapiKey=

# ==============================================
# Production Configuration (Optional)
# ==============================================
# Uncomment and set for production deployments
# SECRET_KEY=your_random_secret_key_here_generate_with_secrets_token_hex
# FLASK_ENV=production
# DATABASE_URL=sqlite:///instance/healthcare_users.db
